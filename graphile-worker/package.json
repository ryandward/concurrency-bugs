    "race": "node src/main.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "graphile-worker": "^0.17.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
